# Normalize line endings
* text=auto eol=lf

# Explicit text types
*.ts    text
*.tsx   text
*.js    text
*.jsx   text
*.json  text
*.css   text
*.html  text
*.md    text
*.svg   text

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Keep lockfiles as-is
package-lock.json -diff
